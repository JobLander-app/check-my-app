{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkmyapp-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "checkmyapp",
      "database_id": "c5c35a91-2589-45f1-8e54-978eca7972dd",
      "migrations_dir": "prisma/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "checkmyapp-evidence"
    }
  ],
  // CHE-362: resizes a step screenshot to its small copy on first request
  // (src/lib/thumbnail.ts). The copy is stored in EVIDENCE, so each screenshot
  // is resized once.
  "images": {
    "binding": "IMAGES"
  },
  // Cross-worker binding to the durable CheckRunWorkflow defined in the agent
  // worker — the web app starts a run by creating an instance (src/lib/trigger.ts).
  "workflows": [
    {
      "name": "checkmyapp-check-run",
      "binding": "CHECK_RUN",
      "class_name": "CheckRunWorkflow",
      "script_name": "checkmyapp-agent"
    }
  ],
  // CHE-341: this worker holds no mail key. Team invites are sent by the agent
  // worker's Mailer entrypoint (src/agent/mailer.ts), which has the key and the
  // sender — one copy of each. CI deploys the agent worker first, so the
  // entrypoint exists before this binding points at it.
  "services": [
    {
      "binding": "MAILER",
      "service": "checkmyapp-agent",
      "entrypoint": "Mailer"
    }
  ],
  "observability": {
    "enabled": true
  }
}
