[Unit]
Description=Session host VNC server on display :99, loopback only (CHE-378)
After=session-xvfb.service
Requires=session-xvfb.service

[Service]
# The display's user; it only listens. websockify, which connects to it, runs
# as session-host — the browser's user cannot connect to loopback at all
# (firewall.nft).
User=session-browser
Group=session-browser
# No VNC password: it listens on 127.0.0.1 only, and the one way in from
# outside is session.checkmyapp.dev, which Cloudflare Access gates to the
# owner's email. A password here would be a second secret to hand him for no
# added protection. A page inside Chrome cannot reach this port either: Chrome's
# user is refused every loopback connection.
#
# -remap: the person signing in sits at a Mac. noVNC sends Cmd as Super, and
# Linux Chrome does nothing on Super+V, so a pasted password never landed
# (2026-10-05). Cmd is Ctrl here: Cmd+V pastes, Cmd+C copies, Cmd+A selects.
#
# -afteraccept (CHE-419): each accepted viewer writes the door's trigger, and
# session-door.path tidies the tab the person is about to see. This user can
# write the file and nothing more; the tidying runs as session-host.
ExecStart=/usr/bin/x11vnc -display :99 -localhost -rfbport 5900 -forever -shared -nopw -noxdamage -quiet -remap Super_L-Control_L,Super_R-Control_R -afteraccept "date +%%s > /var/lib/session-door/connected"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
