{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkmyapp-agent",
  "main": "src/agent/index.ts",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000
  },
  // Watch scheduler (CHE-41). Fires every 15 min; the handler only starts the
  // Watch rows whose nextRunAt is due, capped at 3 runs per tick.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // Public (non-secret) runtime vars. EMAIL_API_KEY is a secret — set it with
  // `wrangler secret put EMAIL_API_KEY --config wrangler-agent.jsonc`.
  // EMAIL_FROM carries a display name (CHE-226): a bare address shows up in the
  // inbox as "verdicts", which is how an unknown bot looks to a stranger's
  // mail provider — and the first verdict to a customer went to spam.
  // EMAIL_REPLY_TO is a mailbox somebody reads: hello@ is routed by Cloudflare
  // Email Routing to the owner (enabled 2026-09-29; before that the domain had
  // no MX and every reply bounced).
  "vars": {
    "APP_URL": "https://checkmyapp.dev",
    "EMAIL_FROM": "CheckMyApp <verdicts@checkmyapp.dev>",
    "EMAIL_REPLY_TO": "CheckMyApp <hello@checkmyapp.dev>"
  },
  "browser": {
    "binding": "MYBROWSER"
  },
  "containers": [{
    "class_name": "ExtensionRunner",
    "image": "./extension-runner/Dockerfile",
    "image_build_context": "./extension-runner",
    // 4 vCPU, not 1. Run 7's Stop confirmation failed with the button visible,
    // enabled and stable and no element intercepting it: the click dispatch
    // itself went unanswered because a live WebRTC call, tab capture, Xvfb and
    // Playwright were sharing standard-2's single core, and the extension's
    // confirmation window is a hard ~2.8s. See docs/extension-verification.md,
    // "Root cause of the Stop-confirmation failure".
    "instance_type": "standard-4",
    "max_instances": 3
  }],
  "durable_objects": {
    "bindings": [{ "name": "EXTENSION_RUNNER", "class_name": "ExtensionRunner" }]
  },
  "migrations": [{ "tag": "extension-runner-v1", "new_sqlite_classes": ["ExtensionRunner"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "checkmyapp",
      "database_id": "c5c35a91-2589-45f1-8e54-978eca7972dd",
      "migrations_dir": "prisma/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "checkmyapp-evidence"
    }
  ],
  "workflows": [
    {
      "name": "checkmyapp-check-run",
      "binding": "CHECK_RUN",
      "class_name": "CheckRunWorkflow"
    }
  ],
  "observability": {
    "enabled": true
  }
}
