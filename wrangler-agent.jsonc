{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkmyapp-agent",
  "main": "src/agent/index.ts",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000
  },
  // Watch scheduler (CHE-41). Fires every 15 min; the handler only starts the
  // Watch rows whose nextRunAt is due, capped at 3 runs per tick.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // Public (non-secret) runtime vars. EMAIL_API_KEY is a secret — set it with
  // `wrangler secret put EMAIL_API_KEY --config wrangler-agent.jsonc`.
  // EMAIL_FROM carries a display name (CHE-226): a bare address shows up in the
  // inbox as "verdicts", which is how an unknown bot looks to a stranger's
  // mail provider — and the first verdict to a customer went to spam.
  // EMAIL_REPLY_TO is a mailbox somebody reads: hello@ is routed by Cloudflare
  // Email Routing to the owner (enabled 2026-09-29; before that the domain had
  // no MX and every reply bounced).
  // CHE-464: apps checked inside a browser a person signed in to (Shopify)
  // run in their team's own browser — the SessionRunner container below.
  // Its secrets: SESSION_JAR_KEY, SESSION_VIEW_SECRET, SESSION_PROXY_URL,
  // SESSION_ADMIN_TOKEN (src/agent/env.ts). When a sign-in has ended, the run
  // says so and the person is told once, in the owner's chat — which needs
  // TELEGRAM_BOT_TOKEN and OWNER_TELEGRAM_CHAT_ID. Without them nothing is
  // sent (signed-out.ts).
  "vars": {
    "APP_URL": "https://checkmyapp.dev",
    "EMAIL_FROM": "CheckMyApp <verdicts@checkmyapp.dev>",
    "EMAIL_REPLY_TO": "CheckMyApp <hello@checkmyapp.dev>",
    // CHE-486: production errors are recorded by signature and, "on", filed as
    // tickets for Mender — the error is the trigger (owner, 2026-10-15). Any
    // other value only records. Switched on 2026-10-16: the 24 hours before had
    // no worker exception and no 5xx on checkmyapp.dev, so there was no noise
    // for a recording phase to find.
    "PROD_ERROR_FILING": "on"
  },
  // CHE-486: every invocation of this worker goes to the monitor as it ends
  // (wrangler-monitor.jsonc); the errors among them come back to
  // ProdErrorIntake below, by signature.
  "tail_consumers": [{ "service": "checkmyapp-monitor" }],
  "browser": {
    "binding": "MYBROWSER"
  },
  "containers": [{
    "class_name": "ExtensionRunner",
    "image": "./extension-runner/Dockerfile",
    "image_build_context": "./extension-runner",
    // 4 vCPU, not 1. Run 7's Stop confirmation failed with the button visible,
    // enabled and stable and no element intercepting it: the click dispatch
    // itself went unanswered because a live WebRTC call, tab capture, Xvfb and
    // Playwright were sharing standard-2's single core, and the extension's
    // confirmation window is a hard ~2.8s. See docs/extension-verification.md,
    // "Root cause of the Stop-confirmation failure".
    "instance_type": "standard-4",
    "max_instances": 3
  }, {
    // CHE-464: one team's Shopify session browser (src/agent/session-runner.ts,
    // spikes/shopify-session/runner.mjs). standard-3 (2 vCPU, 8 GiB): the VM
    // it replaces had two cores, and one core is what broke the extension
    // runner's clicks (above). Billing stops while a team's browser sleeps.
    "class_name": "SessionRunner",
    "image": "./spikes/shopify-session/Dockerfile",
    "image_build_context": "./spikes/shopify-session",
    "instance_type": "standard-3",
    "max_instances": 20
  }],
  "durable_objects": {
    "bindings": [
      { "name": "EXTENSION_RUNNER", "class_name": "ExtensionRunner" },
      { "name": "SESSION_RUNNER", "class_name": "SessionRunner" }
    ]
  },
  "migrations": [
    { "tag": "extension-runner-v1", "new_sqlite_classes": ["ExtensionRunner"] },
    { "tag": "session-runner-v1", "new_sqlite_classes": ["SessionRunner"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "checkmyapp",
      "database_id": "c5c35a91-2589-45f1-8e54-978eca7972dd",
      "migrations_dir": "prisma/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "checkmyapp-evidence"
    }
  ],
  "workflows": [
    {
      "name": "checkmyapp-check-run",
      "binding": "CHECK_RUN",
      "class_name": "CheckRunWorkflow"
    }
  ],
  "observability": {
    "enabled": true
  }
}
