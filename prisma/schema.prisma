// CheckMyApp data model.
//
// A Run is one end-to-end check of a target app: discovery → walking journeys →
// anatomy → verdict. A Run owns Journeys (each with ordered Steps) and Findings.
// A Watch turns a target into a recurring Daily Check that spawns new Runs and
// diffs them against a baseline. Evidence is intentionally first-class: a Step or
// Finding without attached evidence is not trustworthy (see Project Brief).
//
// Storage: Cloudflare D1 (SQLite) via @prisma/adapter-d1. Two SQLite-imposed
// shapes vs the old Postgres schema (proven in spike CHE-21):
//   - no enums → former enum columns are String; type-safety lives in
//     src/lib/enums.ts and is enforced at the app boundary.
//   - autoincrement() is PK-only → runNumber is assigned app-side (see lib/db).
// Keep this layer swappable: nothing here uses D1-only SQL, so a future move
// back to Postgres for enterprise ACID is a provider swap, not a rewrite.

generator client {
  // New ESM generator (not prisma-client-js): emits a workerd-native client
  // with the WASM query compiler inlined and NO Rust engine binary — the only
  // form that survives the OpenNext/esbuild bundle on Cloudflare Workers.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Run lifecycle ───────────────────────────────────────────────────────────
// status: RunStatus · verdict: Verdict — see src/lib/enums.ts

model Run {
  id        String    @id @default(cuid())
  // Unguessable public id used in /run/{id} and /verdict/{id} URLs.
  publicId  String    @unique @default(cuid())
  // Human-facing sequential number, e.g. "Run #4719". Assigned app-side
  // (SQLite autoincrement is PK-only) via a Counter row in a D1 transaction-free
  // safe path — see nextRunNumber() in src/lib/db.ts.
  runNumber Int       @unique
  targetUrl String
  targetKind String @default("website")
  extensionId String?
  extensionConfig String?
  // Installed identity and lifecycle proof belong to this run, not the Store listing.
  extensionEvidence String?
  // App slug derived from the target host, e.g. "joblander.app". Stable across runs.
  appSlug   String

  // Submission inputs. Credentials are encrypted at rest and cleared after the run
  // unless an active Watch keeps them. They must never be logged or appear in evidence.
  testEmail            String?
  testPasswordEnc      String? // encrypted blob, not plaintext
  // CHE-322: the app's named test accounts besides the default one above, as
  // they were when this run was created — JSON [{label, email, passwordEnc}],
  // passwords encrypted like testPasswordEnc and cleared with it after a
  // one-off run (src/lib/test-accounts.ts clearedCredentials). Null = none.
  testAccounts         String?
  // CHE-372: a password-protected store's storefront password (a Shopify
  // store redirects every page to /password until it is entered). An access
  // input like the test login: encrypted the same way, cleared with it after
  // a one-off run (clearedCredentials), and entered by code, never the model.
  storePasswordEnc     String?
  scopeHints           String? // "don't touch /admin"
  userNotes            String? // "don't delete the test account"
  focusAreas           String? // CHE-81: owner's priority concerns
  // CHE-373: App.allowedOrigins as it was when this run was created — JSON
  // array of https origins the run may navigate to and act on besides the
  // target's own. Null = the target's origin only.
  allowedOrigins       String?

  notifyEmail          String?
  // CHE-224: what happened to the verdict email. "sent" / "sent:<provider id>",
  // "skipped: <reason>", "failed: <the provider's own words>". NULL on a
  // terminal run that carried an address means the decision was never reached —
  // which is itself the answer, and queryable. Written by recordNotifyOutcome
  // (src/agent/notify-verdict.ts). Internal: never rendered, never emailed.
  notifyOutcome        String?

  status   String @default("queued") // RunStatus
  verdict  String? // Verdict
  // One-sentence bottom-line verdict shown under the header pill.
  bottomLine String?
  // LLM-generated "App Lens": 5–7 bullets describing the product. User-editable.
  appLens  String? // JSON (AppLens)
  // User reaction to the Lens: null = none, "confirmed" = Looks right,
  // free text = "Something's off" correction (agent re-reads it next run).
  lensFeedback String?
  // App Anatomy: { pages[], actions[], services[], tech{} }.
  anatomy  String? // JSON (AppAnatomy)
  // Free-form progress events for the live feed (phase log lines).
  events   String? // JSON RunEvent[] — see src/lib/types.ts
  // Live-screen theatre: what the agent is doing right now, in plain English,
  // and the most recent screenshot of its browser. Updated by the worker.
  currentAction      String?
  liveScreenshotUrl  String?

  // Deploy identity (CHE-56): which build this run verified. Set by CI through
  // the API/MCP; null for browser submissions and scheduler runs, which are not
  // tied to a deploy. Free text — the sha is whatever the caller's VCS calls a
  // revision, and createCheckSchema is the only gate on its shape.
  deploySha String?
  deployEnv String? // "production", "staging", … caller's own naming

  errorMessage String?
  // Audit artifact: file URL of the agent-loop transcript (tool calls + results).
  transcriptUrl String?
  // Rolled-up Anthropic API cost of this run (CHE-16). USD.
  costUsd Float?

  watch    Watch?  @relation(fields: [watchId], references: [id])
  watchId  String?
  // The baseline run this one is diffed against (Daily Check).
  baselineRunId String?
  // Full re-check (CHE-74): the owner explicitly asked to walk everything from
  // scratch — replay/partial planning skip themselves when set.
  forceFull     Boolean @default(false)
  // CHE-327: what the customer paid for this check, in USD — what it cost us
  // × the plan's multiplier (src/lib/plans.ts priceRun), set when the run
  // finishes. 0 for a run that failed (our failure is free, rule 4); null
  // while in flight, and on anonymous runs, which belong to no balance.
  priceUsd          Float?
  // The part of priceUsd that came off the team's bought balance because the
  // plan's credit for the window could not cover it. The window's plan
  // spending is sum(priceUsd - priceFromTopupUsd) — no counter to keep in sync.
  priceFromTopupUsd Float   @default(0)
  // How many pages a quick check (nothing changed, nothing walked) opened —
  // the work its few-cent price paid for, said next to the price
  // (src/lib/check-price.ts). Null on every other run.
  quickPagesOpened  Int?
  // CHE-327: which door started this check — "watch" (the scheduler), "mcp"
  // (the coding agent), "api" (a key over REST), "ui" (the dashboard, a
  // verdict's re-check, onboarding) or "anon" (the free/paid public form).
  // The balance is one pool on purpose; this is how we learn what it is spent
  // on (scripts/measure/pricing-hypotheses.ts). Internal; null before CHE-327.
  startedVia        String?
  // CHE-100: an auth endpoint rejected the credential we hold. Set the first
  // time it happens and never cleared within the run — it stops any further
  // sign-in attempt (five of them locked a customer's account once) and marks
  // everything behind that login missing_access rather than broken.
  credentialsRejected Boolean @default(false)
  // CHE-322: WHICH accounts were turned away, JSON string[] of labels
  // ("default" for testEmail above). credentialsRejected stays the "any of
  // them" flag every reader already keys on; this is the name the verdict
  // gives. Null on a row with credentialsRejected set means the one account
  // that existed before named accounts did — the default.
  rejectedAccounts    String?
  // CHE-372: what the store's own password page made of the store password we
  // hold (storePasswordEnc). Null = never submitted; "pending" = written BEFORE
  // a submission and left there when its outcome is unknown (a submit that
  // threw, a write that failed) — no phase submits again; "accepted" = the
  // store let us in, and each new browser context may enter it once more;
  // "rejected" = turned away, never submitted again this run (CHE-100's rule).
  storePasswordState String?
  // CHE-132: the free page survey this run took before deciding its mode.
  // A plain id, no relation: snapshots are the app's history and must outlive
  // any one run.
  snapshotId    String?

  // M3: owner-scoping. Anonymous runs keep these null and stay reachable only
  // by their unguessable publicId — the multi-tenant layer is additive.
  app      App?    @relation(fields: [appId], references: [id])
  appId    String?
  owner    User?   @relation(fields: [ownerId], references: [id])
  ownerId  String?
  // CHE-253: whose run this is, now that "whose" can be more than one person.
  // Null on anonymous and ephemeral runs, exactly like ownerId. `ownerId` stays
  // filled on every owned run — isOwnRun (src/agent/notify-verdict.ts) reads it
  // to decide the self-check silence, and a run that arrived with only a team
  // would strand that rule (CHE-156).
  team     Team?   @relation(fields: [teamId], references: [id])
  teamId   String?
  // Anonymous counterpart of ownerId: a salted one-way hash of the submitter's
  // IP, set only on anonymous runs so the free-run quota (CHE-40) can be counted
  // per client without ever storing an IP. Null on owner and scheduler runs.
  anonKeyHash String?
  // Paid one-off check (launch, 2026-09-05): the Stripe Checkout Session that
  // paid for this run. Unique so a webhook and the success-page poll racing to
  // start the same paid check can only produce one run — D1 has no
  // transactions, so the constraint is the lock. Null on every other run.
  paidCheckoutSessionId String? @unique
  // CHE-202: a PR-preview hostname is a run, not an app. An ephemeral run is
  // owned (private, never listed), has no App row and never gets one — no
  // watch, no tracker, no repo — and is deleted outright, evidence included,
  // once expiresAt passes (src/lib/ephemeral.ts, swept by the janitor). The
  // only run we ever delete: the target it describes no longer exists either.
  ephemeral Boolean   @default(false)
  expiresAt DateTime?

  journeys Journey[]
  findings Finding[]
  llmUsage LlmUsage[]
  // CHE-90: everything this run created in the target product, so cleanup is
  // auditable even when the run dies mid-journey.
  createdResources CreatedResource[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([appSlug])
  @@index([watchId])
  @@index([appId])
  @@index([ownerId])
  @@index([teamId])
  @@index([teamId, createdAt])
  // The sidebar's "latest verdict per app" seeks on this, on every signed-in
  // page (src/lib/shell-data.ts).
  @@index([teamId, appId, completedAt])
  @@index([anonKeyHash])
  @@index([ephemeral, expiresAt])
}

// Ledger of records the agent created inside a customer's product (CHE-90).
// Written the moment something is created — before the walk continues — so a
// crash can never hide it. The end-of-run audit reports anything still alive.
model CreatedResource {
  id     String @id @default(cuid())
  run    Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId  String
  appId  String?

  kind        String // "story", "app", "job posting" — the product's own word
  marker      String // the recognisable string we typed in; cleanup keys on it
  locationUrl String?
  notes       String?

  deletedAt   DateTime?
  cleanupNote String?

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([appId, deletedAt])
}

// ─── The journey catalog (CHE-231) ───────────────────────────────────────────
// A UX journey is the unit of a run. It belongs to the APP and outlives every
// run: "someone signs up" is the same journey in Run #12 and Run #157, whatever
// wording the model reached for that day. Before this row existed, continuity
// was reconstructed by matching free-text titles from the last run — and
// joblander.app wrote 167 distinct titles for ~13 journeys across 60 runs, so
// there was nothing to match.
//
// Identity is decided in code, never by a prompt: src/lib/journey-key.ts
// resolves a title to one of these rows (scripts/verify-journey-identity.ts
// drives the real 167 titles through it). The row is per App, because an App is
// already "one owner ↔ one target"; an anonymous one-off run has no continuity
// to accumulate and gets no catalog row, only the key on its journeys.

model AppJourney {
  id    String @id @default(cuid())
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String
  // Stable slug from journey-key.ts: "signup", "install-extension",
  // "practic-interview-ai". Unique per app; never rewritten once assigned —
  // a key that moves is a history that restarts.
  key   String
  // The current canonical wording, i.e. the last walk's title. Display only:
  // nothing keys on it.
  title String
  // Every distinct title we have resolved to this journey, JSON string[]. The
  // audit trail for a merge — what the identity rules folded together is
  // always visible, not just their verdict.
  aliases String @default("[]")
  // The plan: ordered step labels from the last walk that produced any, JSON
  // string[]. What discovery is asked to confirm and what a re-walk starts from.
  plan    String @default("[]")
  // CHE-235: where the journey lives. "app" for one that crosses the product
  // (sign up → first value), or the path of the surface it belongs to
  // ("/settings"). A page can hold several journeys — joblander's /settings has
  // coach preferences, the resume upload and the extension pairing, and they
  // are three journeys, not three wordings of one. Identity is matched WITHIN a
  // surface for exactly that reason (src/lib/journey-key.ts). NULL means we
  // have not been told yet, and matches anything rather than splitting a
  // journey off from its own history.
  surface String?
  // CHE-247: what the product DOES on this journey, when something other than a
  // model can say so — today the extension executor's scenario ("interview",
  // "practice", "practice-extension"). Gated in code rather than described in
  // prose, so identity checks it BEFORE any title rule: two rows with different
  // known scenarios are different journeys even with byte-identical titles.
  // NULL matches anything, so nothing that predates the column is split off
  // from its own history.
  scenario String?

  // Current state, updated by every run that walks it. status is the same
  // StepStatus roll-up the per-run row carries.
  status          String?
  lastRunId       String? // the last run that had this journey at all
  lastRunNumber   Int?
  // When it was last ACTUALLY walked (a carried copy does not move this) and by
  // which run — the provenance any "verified on" claim must be built from.
  lastWalkedAt    DateTime?
  lastWalkedRunId String?
  walkCount       Int @default(0)
  // How many consecutive walks ended worse than ok/partial, and since when.
  // Cleared the moment a walk comes back healthy.
  consecutiveBad  Int       @default(0)
  failingSince    DateTime?
  // Everything this journey has cost us, summed over its checks. The journey is
  // the unit of work, so it is also the unit of spend.
  costUsd         Float @default(0)

  // CHE-235 — what the journey costs the PERSON walking it, which is a
  // different question from what it costs us and a far more interesting one.
  // price: how many actions they perform. conversion: of 100 who start, how
  // many finish. Both opinionated, both assigned by the model at discovery
  // against the stored value, both policed by src/agent/journey-metrics.ts —
  // a changed number whose note names no change is refused and the stored one
  // stands. prev* is the value before the last move, so "6 → 8 actions" is
  // readable without joining the run history.
  price          Int?
  conversion     Int?
  prevPrice      Int?
  prevConversion Int?
  // The model's one sentence: what changed, or why this is the first value.
  // Internal — never rendered into a verdict or an email as written.
  metricNote     String?
  metricRunId    String?
  metricAt       DateTime?
  // A journey the product no longer has. Kept, never deleted (it is the record
  // of what the app used to do) and never walked again.
  //
  // CHE-232: `missedDiscoveries` is how many consecutive FULL checks mapped the
  // app without finding this journey. Only a full check maps — a smoke pass and
  // a partial run propose nothing, so neither moves this. At three, the journey
  // retires; a journey walked again has it cleared and its retirement undone,
  // so a page that comes back brings its history with it.
  missedDiscoveries Int @default(0)
  retiredAt     DateTime?
  retiredReason String?

  // CHE-238: the funnel this journey's walk implies — the ordered pages a
  // person moves through — derived from what the walk recorded, never from
  // anything the customer was asked to define. The first derivation wins and a
  // later disagreement is noted in funnelDriftAt rather than applied, because a
  // funnel that changes shape silently makes every comparison meaningless.
  // funnelRefusal names OUR gap when there is no funnel (rule 2); it is what a
  // "[Checker gap]" is filed from and never reaches a verdict.
  funnelStages    String?
  funnelRefusal   String?
  funnelDerivedAt DateTime?
  funnelDriftAt   DateTime?

  // CHE-239: what the customer's analytics say happened, one point per run.
  // Deliberately a relation and not a column: `conversion` above is OUR opinion
  // formed by walking; these are THEIR counts. A number whose provenance is
  // ambiguous is worse than either number alone.
  metricPoints JourneyMetricPoint[]

  checks Journey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, key])
  @@index([appId, retiredAt])
}

// CHE-239: what the customer's own analytics say happened on a journey — one
// point per run, so "conversion fell from 31% to 12% over three weeks" is a
// question the data can answer. A single mutable column can only say what today
// looks like, and by the time anyone asks why, the before is gone.
//
// Separate from AppJourney.conversion on purpose: that is OUR opinion formed by
// walking, this is THEIR count. Nobody can act on a number without knowing
// which of the two it is.
model JourneyMetricPoint {
  id           String     @id @default(cuid())
  journey      AppJourney @relation(fields: [appJourneyId], references: [id], onDelete: Cascade)
  appJourneyId String
  /// The run that asked. A point outlives the run row it came from.
  runId        String?
  measuredAt   DateTime   @default(now())
  /// How far back the question looked. Per point, because changing the window
  /// changes the question and a series that mixes them is a trend about nothing.
  windowDays   Int
  /// 0-100, or null when we counted and the sample was below the floor. Null
  /// here is a real answer; a run whose query FAILED writes no row at all.
  conversion   Int?
  /// People who reached the first stage — what makes `conversion` trustworthy
  /// or absent. Always present.
  sampleSize   Int
  /// Per-stage counts in funnel order, as JSON. Counts only, never a person.
  steps        String?
  source       String     @default("posthog")
  createdAt    DateTime   @default(now())

  @@index([appJourneyId, measuredAt])
}

// ─── Journeys & steps ────────────────────────────────────────────────────────
// status: StepStatus — see src/lib/enums.ts

model Journey {
  id      String  @id @default(cuid())
  run     Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId   String
  order   Int
  title   String // "Sign up → first mock interview"
  // CHE-231: which journey of the app this is a check of. Null on runs with no
  // App row (anonymous one-off checks, PR previews) and on rows written before
  // the catalog existed — journeyKey is filled in either way, so even those
  // rows can be grouped by identity.
  appJourney   AppJourney? @relation(fields: [appJourneyId], references: [id], onDelete: SetNull)
  appJourneyId String?
  journeyKey   String?
  // CHE-235: "app" or the path this journey belongs to, and what this check
  // said the journey costs its user — price in actions, conversion out of 100.
  surface      String?
  // CHE-247: the scenario this check was gated to (see AppJourney.scenario).
  scenario     String?
  price        Int?
  conversion   Int?
  // What this check cost: the walking loop plus its judge, the same number that
  // lands in LlmUsage for this journey. Null on a carried journey — nothing was
  // spent walking it — and on rows written before the column.
  costUsd      Float?
  status  String // StepStatus — worst-case roll-up of its steps
  summary String? // "What we found: signup fails on Safari mobile (~18% of traffic)"
  videoUrl String? // recording of the agent walking this journey
  // Partial watch runs (CHE-57) copy healthy journeys forward instead of
  // re-walking them. This names the run that ACTUALLY walked it — the
  // provenance root, not the run it was copied from — so the verdict page can
  // say "carried · Run #42" and never imply we re-verified it today. NULL means
  // this run walked it itself. A plain id, not a relation: the source run may be
  // pruned one day and losing provenance must not cascade-delete the journey.
  carriedFromRunId String?
  // CHE-129 spike: after the LLM walked this journey, the recorded Step.actions
  // were replayed against the live app with no model in the loop, and this is
  // how that went — reproduced | no_actions | refused | diverged | errored.
  // Internal measurement only (never rendered, never in a verdict or email):
  // it decides whether walking can stop re-discovering yesterday's path.
  replayStatus String?
  replayNote   String?

  steps   Step[]

  @@index([runId])
  @@index([appJourneyId])
}

model Step {
  id         String     @id @default(cuid())
  journey    Journey    @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  journeyId  String
  order      Int
  label      String // "Try mock interview on iPhone → 500"
  status     String // StepStatus
  // Denormalized thumbnail for the journey strip card (full set lives in Evidence).
  screenshotUrl String?
  attempted  String? // what the agent tried to do
  observed   String? // what happened
  // CHE-83: why a skipped step went unverified — our_capability (our defect,
  // auto-filed against us) | missing_access | not_applicable.
  unverifiedReason String?
  // CHE-198: which of our capabilities an our_capability step ran into
  // (src/agent/gap-classes.ts), decided at report time from the model's own
  // words and the machine trail — the filer reads it instead of guessing from
  // the customer's copy. NULL for other reasons and for rows written before.
  gapClass   String?
  consoleLog String?
  networkLog String? // HAR excerpt
  // CHE-129: the machine actions (navigate/click/fill) the walk executed for
  // this step, as JSON — the part of the walk a browser can redo without a
  // model. Prose above is for people; this is for replay. Credentials stay as
  // {{TEST_EMAIL}}/{{TEST_PASSWORD}} placeholders. NULL when the step reported
  // nothing executable (a read-only observation) or predates the column.
  actions String?

  evidence   Evidence[]

  @@index([journeyId])
}

// ─── Findings (the QA fallout) ───────────────────────────────────────────────
// category: FindingCategory · severity: Severity · mark: FindingMark

model Finding {
  id        String          @id @default(cuid())
  run       Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  // Human-facing sequential number within a run, e.g. #001.
  number    Int
  title     String
  category  String // FindingCategory
  severity  String // Severity
  // Structured detail: where, browser, reproduced, whatWeTried[], whatHappened, whyItMatters.
  detail    String? // JSON (FindingDetail)
  // CHE-215: what this finding was allowed to rest on, written when it was.
  // JSON, internal only — never rendered, never emailed:
  //   { stepRef: {journeyIndex, stepIndex} | null, hands: string[], trail: "present"|"absent" }
  // The retro this ticket asked for had to infer stepRef from whether a
  // screenshot row existed, because persistence read it and dropped it. NULL
  // on every row written before the column.
  anchor    String?
  // CHE-354: which problem this is, across checks, however it was worded —
  // src/lib/finding-signature.ts. Title and severity are not part of it. NULL
  // on rows written before the column until the backfill
  // (scripts/backfill-finding-signature.ts); src/lib/recurring.ts computes it
  // for those on the fly.
  signature String?
  mark      String          @default("none") // FindingMark

  evidence  Evidence[]

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([signature])
}

// ─── Evidence (first-class) ──────────────────────────────────────────────────
// type: EvidenceType — see src/lib/enums.ts

model Evidence {
  id          String       @id @default(cuid())
  type        String // EvidenceType
  storageUrl  String // /api/evidence/... (R2-backed)
  sha256      String? // content hash for integrity (RFC3161 timestamping is post-MVP)
  capturedAt  DateTime     @default(now())

  step        Step?    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId      String?
  finding     Finding? @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId   String?

  @@index([stepId])
  @@index([findingId])
}

// ─── Generated e2e tests (CHE-8) ─────────────────────────────────────────────
// The agent formalizes each walked journey as an executable Playwright spec.
// Daily Watch replays these deterministically; the LLM only investigates diffs.

model GeneratedTest {
  id        String   @id @default(cuid())
  appSlug   String
  journeyId String?
  title     String // "Submit a check"
  // Playwright spec source (TypeScript). Executed from generated-tests/{appSlug}/.
  content   String
  sha256    String
  version   Int      @default(1)
  // Result of the most recent replay: passed / failed / never_run.
  lastRunStatus String @default("never_run")
  lastRunAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appSlug])
}

// ─── Daily Watch ─────────────────────────────────────────────────────────────
// frequency: WatchFrequency — see src/lib/enums.ts

model Watch {
  id          String         @id @default(cuid())
  // NOT globally unique (CHE-36): two owners may watch the same URL. The real
  // key is appId (one Watch per App); appSlug stays for display/legacy lookups.
  appSlug     String
  targetUrl   String
  frequency   String         @default("daily") // WatchFrequency
  active      Boolean        @default(true)
  // Notify only when something meaningful changed vs. notify after every run.
  notifyOnChangeOnly Boolean @default(true)
  notifyEmail String?

  // Encrypted test credentials retained for recurring runs.
  testEmail        String?
  testPasswordEnc  String?
  // CHE-372: mirrored from App.storePasswordEnc, like the test login above.
  storePasswordEnc String?

  // M3: owner-scoping + one Watch per App. Legacy anonymous watches keep null.
  app      App?    @relation(fields: [appId], references: [id])
  appId    String? @unique
  owner    User?   @relation(fields: [ownerId], references: [id])
  ownerId  String?
  // CHE-253: the team whose plan pays for this watch and whose members may
  // configure it. Null only on legacy ownerless watches.
  team     Team?   @relation(fields: [teamId], references: [id])
  teamId   String?

  runs        Run[]
  lastRunAt   DateTime?
  nextRunAt   DateTime?

  // CHE-54: a watch enabled on the Free plan is a 7-day trial. NULL = not a
  // trial (paid owner, or a legacy ownerless watch) and never expires — see
  // shouldSkipWatch in lib/plans. trialNoticeSentAt stamps the one-time
  // "watch paused" email so the cron can't repeat it every 15 minutes.
  trialEndsAt       DateTime?
  trialNoticeSentAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([teamId])
  @@index([appSlug])
}

// ─── App-side counters (CHE-11) ──────────────────────────────────────────────
// SQLite autoincrement() is PK-only, so the human-facing Run.runNumber is
// assigned from this single-row counter instead of a DB sequence.

model Counter {
  name  String @id // e.g. "runNumber"
  value Int    @default(0)
}

// ─── Paid one-off check (launch, 2026-09-05) ─────────────────────────────────
// What a visitor typed into the form, parked while they pay. A Run is created
// from it only once Stripe says the session is paid; until then nothing runs
// and nothing is billed. Anonymous: no User, no Stripe customer.

model PendingCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  targetUrl       String
  extensionConfig String?
  testEmail       String?
  // Encrypted like Run.testPasswordEnc; cleared the moment the run is created.
  testPasswordEnc String?
  // CHE-372: encrypted the same way; cleared with testPasswordEnc.
  storePasswordEnc String?
  userNotes       String?
  notifyEmail     String?
  // Same salted IP hash the anonymous quota uses, carried onto the run.
  anonKeyHash     String?
  // The buyer's PostHog distinct id (from the cookie on the POST), so the
  // server-side events the payment produces join the browser's own events.
  distinctId      String?

  // The Stripe Checkout Session created for this pending check.
  checkoutSessionId String? @unique
  // Set once the run exists; the idempotency marker for the start.
  runId             String? @unique
  // Unpaid rows are garbage after this.
  expiresAt DateTime
}

// ─── M3: Owner accounts & per-owner QA→tracker loop (CHE-27) ──────────────────
// Identity of record is Clerk (Google OAuth + email-code; Organizations for
// multi-tenancy; SSO deferred — paid). This `User` is a THIN mirror synced via
// Clerk webhooks so domain rows can tenant-scope without calling Clerk per
// request. role/plan are String unions (no SQLite enums) — see src/lib/enums.ts.

model User {
  // CHE-105: a real, sign-in-able account used to check CheckMyApp with
  // CheckMyApp. Everything it does is SILENT — its runs never mail the real
  // owner — and everything it owns is disposable: the janitor clears it.
  isTestAccount Boolean @default(false)

  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String
  name        String?
  role        String  @default("requester") // requester | provider_human | agent_operator | admin

  // CHE-253 (Teams T0): plan, stripeCustomerId, stripeSubscriptionId and
  // clerkOrgId used to live here. They are the TEAM's now — a person does not
  // have a plan, the team they act for does. Keeping a copy on the user would
  // be two columns meaning the same thing, which is how a rule ends up keyed
  // on the wrong subject (CHE-156).

  notifies    AppNotifier[]
  memberships Membership[]
  // What this person did, kept apart from who owns it: a row's `ownerId` is
  // attribution and is never rewritten when somebody leaves a team.
  apps    App[]
  runs    Run[]
  watches Watch[]
  apiKeys ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Teams (CHE-253) ─────────────────────────────────────────────────────────
// A team owns the apps, pays the bill and grants the access. A personal account
// IS a team of one (isPersonal), created for every user the moment they exist,
// so there is exactly one billing subject and one access subject in the code
// and nothing branches on "team or not".
//
// Clerk is identity only. Membership and scope live here because Clerk's own
// organizations give two roles (org:admin, org:member) and a third needs custom
// roles — free in development, requiring the B2B Authentication add-on in
// production, with a 20-member ceiling without it. Verified 2026-09-15.

model Team {
  id   String @id @default(cuid())
  name String
  // True for the team created automatically for one person. Not special-cased
  // anywhere in the product: it is a team, with one admin, that happens to have
  // been created for them rather than by them.
  isPersonal Boolean @default(true)

  // What the team pays for. Moved here from User by the same migration that
  // created this table, value for value — nobody's plan changed on deploy day.
  plan String @default("free") // free | starter | growth | business | enterprise

  // Stripe billing. The customer is 1:1 with a TEAM; when the person who
  // subscribed leaves, the subscription stays with the team that paid.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?

  // CHE-327: balance the team bought (USD) and has not spent yet. Spent only
  // after the plan's credit for the window; never expires, never resets. May
  // sit slightly below zero after a check that finished above what was left —
  // which blocks the next start until a top-up or the plan's next credit.
  // Credited by the Stripe webhook (BalanceTopUp is the receipt that makes the
  // credit happen once), taken by priceRun, given back by voidRunPrice.
  topupUsd Float @default(0)
  // CHE-327: when the "balance is used, recurring checks paused" mail last
  // went out, so the scheduler (every 15 minutes) sends it once per window
  // rather than once per tick.
  balanceNoticeSentAt DateTime?

  topUps BalanceTopUp[]
  memberships Membership[]
  invites     TeamInvite[]
  events      TeamEvent[]
  apps        App[]
  runs        Run[]
  watches     Watch[]
  apiKeys     ApiKey[]
  // CHE-236: the team's analytics connection, at most one.
  posthog     PostHogIntegration?
  testAccounts TestAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// CHE-327: one paid top-up of a team's balance. The Checkout Session id is
// unique, so Stripe retrying a webhook (or delivering it twice) can create the
// receipt only once; `credited` is claimed before the team's balance is
// incremented, so a retry after a crash between the two finishes the credit
// instead of repeating it. D1 has no transactions — the unique key and the
// claim are the locks.
model BalanceTopUp {
  id                String   @id @default(cuid())
  checkoutSessionId String   @unique
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String
  amountUsd         Float
  credited          Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([teamId])
}

/// CHE-236 — the analytics connection, made once for the team.
///
/// Keyed by team rather than by owner (the ticket predates CHE-253): the plan
/// and the subscription belong to the team, and a connection owned by one
/// member would strand everyone else the day that person leaves — the same
/// defect shape as team knowledge stored per person. `connectedByUserId` is
/// attribution only, mirroring how Run keeps ownerId alongside teamId.
///
/// One row per team, enforced by the database. Two tokens for one team is a
/// question nobody can answer ("which do we read from?"). The alternative —
/// unique on (teamId, organizationId), allowing a team two PostHog
/// organisations — was considered and deferred: PostHog does not document
/// whether a token is scoped to one organisation, and a unique index over a
/// column that may be NULL for every row enforces nothing in SQLite. It is a
/// cheap migration the day a real team needs two.
model PostHogIntegration {
  id     String @id @default(cuid())
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String @unique
  /// Who pressed Connect. Access follows the team, not this.
  connectedByUserId String?

  /// Encrypted at rest (src/lib/crypto), like every other stored credential.
  accessTokenEnc  String
  refreshTokenEnc String?
  /// Absolute, never a duration: a lifetime stored at write time is wrong by
  /// however long the row has been sitting there (CHE-68).
  expiresAt       DateTime?
  /// What PostHog actually granted, as it reported back — so a later read can
  /// say "this connection cannot answer that" instead of surfacing a raw 403.
  scope           String?

  organizationName String?
  organizationId   String?
  /// us | eu, as discovered during the flow.
  region           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Who is on a team and what they may do. scope is admin | member | reader —
// the table of what each may do is src/lib/scopes.ts (CHE-254), never a prompt
// and never a per-route comparison.
model Membership {
  id     String @id @default(cuid())
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  scope  String @default("member") // TeamScope — see src/lib/scopes.ts

  // Who brought them in. Null on the admin of a personal team, which nobody
  // invited, and on rows the backfill created.
  invitedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

// An invitation to a team (CHE-257). Ours, not Clerk's: the scope is decided at
// invite time and is one of our three (src/lib/scopes.ts), which Clerk's
// organizations cannot express without a paid add-on — and routing invites
// through them while keeping the real scope here would be two sources of truth
// for one fact.
//
// Only a hash of the token is stored. The raw token exists in the emailed link
// and nowhere else, the same shape ApiKey.keyHash already uses: a database dump
// does not let anyone join a team.
// CHE-264 (Teams T11): who changed what. Written by the functions that perform
// the change, never by a caller who remembers — a log kept by habit is complete
// until the first person forgets. Read by everyone on the team: an account log,
// never anything a customer reads about their own product (rule 1).
model TeamEvent {
  id     String @id @default(cuid())
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String
  // Null when our own system did it — a Stripe webhook, the scheduler. "System"
  // is an answer; a blank that means "we did not record it" is not.
  actorUserId String?
  action      String  // TeamEventAction — see src/lib/team-events.ts
  // What it happened to, in the team's own words: an email, an app slug, a key
  // name. Never an id.
  subject     String?
  summary     String

  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}

model AppNotifier {
  id     String @id @default(cuid())
  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@unique([appId, userId])
  @@index([appId])
  @@index([userId])
}

model TeamInvite {
  id     String @id @default(cuid())
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String
  // Where the invitation was sent. NOT what is matched on acceptance — a person
  // signs in with the account they actually use, which is often not the address
  // a colleague typed. The token is the capability; the email is the delivery.
  email  String
  scope  String @default("member") // TeamScope

  tokenHash       String  @unique // SHA-256 hex of the raw token
  invitedByUserId String

  expiresAt      DateTime
  // Set when it is used, revoked, or replaced by a resend. An invite is never
  // deleted: "who invited whom, and what happened to it" is the audit trail
  // T11 reads, and a row that vanishes takes its own history with it.
  acceptedAt     DateTime?
  acceptedByUserId String?
  revokedAt      DateTime?
  revokedReason  String? // "revoked" | "resent"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([email])
}

// Owner API keys (CHE-52): let a coding agent act as the owner over the public
// HTTP API (Authorization: Bearer cma_…). Only a SHA-256 hash of the raw key is
// stored — the raw key is shown once at creation and never again. Runs started
// with a key are attributed to the owner and follow the owner's plan quota.
model ApiKey {
  id         String    @id @default(cuid())
  // Attribution: who minted it. The key is the TEAM's (CHE-253) — a CI hook
  // does not stop working because the person who created it left.
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  team       Team?     @relation(fields: [teamId], references: [id])
  teamId     String?
  // CHE-263: what this key may do, from the same three scopes a person has
  // (src/lib/scopes.ts). A key cannot be minted above the scope of the person
  // minting it, and a reader key is the one customers will actually ask for: a
  // token that can read every verdict and spend nothing.
  scope      String    @default("member") // TeamScope
  name       String // owner-facing label, e.g. "CI post-deploy hook"
  keyHash    String    @unique // SHA-256 hex of the raw `cma_<32 hex>` key
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([ownerId])
  @@index([teamId])
}

// One owner ↔ one target app. Holds the canonical appSlug for that owner; a URL
// checked by two different owners is two Apps. The owner-facing test creds live
// here (encrypted); anonymous one-off runs never create an App.
model App {
  id        String  @id @default(cuid())
  // Attribution: the person who added it. Ownership is the team's (CHE-253) —
  // removing a person removes nothing they touched.
  owner     User    @relation(fields: [ownerId], references: [id])
  ownerId   String
  // The team this app belongs to. Nullable only because SQLite cannot add a
  // NOT NULL column to a populated table without a default; every App has one,
  // and scripts/verify-team-backfill.ts is what makes that true rather than
  // hoped for.
  team      Team?   @relation(fields: [teamId], references: [id])
  teamId    String?
  targetUrl String
  targetKind String @default("website")
  extensionId String?
  extensionConfig String?
  appSlug   String

  // Target test credentials retained for recurring runs (encrypted, never logged).
  // CHE-322: this pair IS the test account labelled "default"; any others
  // live in testAccounts, where that label is reserved — one place per account.
  testEmail       String?
  testPasswordEnc String?
  testAccounts    TestAccount[]
  // CHE-372: the store password of a password-protected store (Shopify's
  // /password page). Write-only like the test password: no read path returns
  // it; list_apps says only whether one is stored.
  storePasswordEnc String?
  scopeHints      String?
  userNotes       String?
  // Priority concerns (CHE-81): what the owner is most worried about, in their
  // own words. Discovery must cover each with a journey; walking verifies.
  focusAreas      String?
  // CHE-373: further https origins a check may navigate to and act on — an
  // embedded app's host page and the frame it renders in (Shopify admin and
  // the app's own origin). JSON array, validated by src/lib/allowed-origins.ts.
  // Null = the app's own origin only.
  allowedOrigins  String?
  // CHE-90: may the agent create records while checking? read_only (default)
  // or create_cleanup — full CRUD lifecycle, every creation removed again.
  writeMode       String  @default("read_only")

  // Outbound integrations (CHE-53). A generic webhook POSTed after EVERY
  // completed watch run (consumers filter — that's the observability contract),
  // optionally HMAC-signed with the encrypted secret; plus a Slack incoming
  // webhook that gets a Blocks-formatted version of the same event.
  webhookUrl       String?
  webhookSecretEnc String? // encrypted blob (src/lib/crypto), never logged
  slackWebhookUrl  String?

  // CHE-237: which PostHog project holds this app's data. The connection is the
  // team's; the project is the app's, because only the owner can say which of
  // their projects is this product. The name is a cached label so the settings
  // page reads correctly even when the connection is expired or gone; the id is
  // the only part ever sent to PostHog. Null is not broken — an app with no
  // project keeps our own estimate and says so once.
  posthogProjectId   String?
  posthogProjectName String?

  notifiers AppNotifier[]
  watch   Watch?
  tracker TrackerIntegration?
  repo    RepoIntegration?
  policy  TicketPolicy?
  runs    Run[]
  issues  IssueLink[]
  // CHE-231: the app's journeys — the units its runs are made of.
  journeys AppJourney[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One owner ↔ one target app, unchanged by T0 on purpose. With a personal
  // team per person, "one team ↔ one target" says the same thing today, and
  // moving the constraint would rewrite every `ownerId_appSlug` lookup in the
  // product for no behaviour gained. It moves in T5, when a second member can
  // add an app and the two stop being the same sentence.
  @@unique([ownerId, appSlug])
  @@index([ownerId])
  @@index([teamId])
}

// CHE-322: a named test account of an app — "admin", "free user" — beyond the
// default one held on App.testEmail / App.testPasswordEnc. A scenario that says
// "as admin: …" signs in as the row labelled admin; the model only ever sees
// the label (src/lib/test-accounts.ts has the whole design).
model TestAccount {
  id     String @id @default(cuid())
  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId  String
  // The team that owns the app, stamped so every query for a credential can
  // say whose it is (CHE-256) without joining through the App.
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String
  // Normalized lower case (normalizeAccountLabel). "default" is never stored:
  // it names the App's own columns.
  label  String
  email  String
  // Encrypted like App.testPasswordEnc (src/lib/crypto). Write-only: no read
  // path returns it, decrypted or not, outside the agent's fill tool.
  passwordEnc String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, label])
  @@index([teamId])
}

// The owner's connected issue tracker. type='linear' for now, behind a Tracker
// abstraction (Jira/GitHub later). Tokens encrypted at rest (src/lib/crypto.ts).
model TrackerIntegration {
  id              String    @id @default(cuid())
  app             App       @relation(fields: [appId], references: [id])
  appId           String    @unique
  type            String    @default("linear") // linear | jira | github
  accessTokenEnc  String
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  teamId          String?   // tracker team/project the tickets land in
  externalOrg     String?   // workspace/org identifier

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The owner's connected code host, used to export generated Playwright specs
// as a PR (verdict "Export to GitHub"). Separate from TrackerIntegration: code
// host ≠ issue tracker, and Linear may already occupy that (unique) slot.
// provider='github' only for now. v1 auth is an owner-provided fine-grained PAT
// (Contents + Pull requests read/write on one repo), encrypted at rest via
// src/lib/crypto.ts — swapping to a GitHub App later only changes how tokenEnc
// is obtained. We never push to defaultBranch; export is branch + PR only.
model RepoIntegration {
  id            String @id @default(cuid())
  app           App    @relation(fields: [appId], references: [id])
  appId         String @unique
  provider      String @default("github")
  tokenEnc      String
  repoFullName  String // "owner/repo"
  defaultBranch String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// How a 🔴 regression becomes a ticket the owner's automation will pick up.
// JobLander (tenant #1) seed: pickupLabels=["monitor"], repoLabel="repo: joblander-app".
// Generalizes Contract v1 (the labels were hardcoded there).
model TicketPolicy {
  id                String  @id @default(cuid())
  app               App     @relation(fields: [appId], references: [id])
  appId             String  @unique
  pickupLabels      String  @default("[]") // JSON string[] — owner's automation pickup key(s)
  repoLabel         String?                // routing label, e.g. "repo: joblander-app"
  provenanceLabel   String  @default("checkmyapp")
  state             String  @default("Backlog")
  priorityRule      String  @default("{}") // JSON: journeys → priority, e.g. {"urgent":["login","dashboard"]}
  titleFormat       String  @default("[Monitor] {verdict}")
  escalateAfterRuns Int     @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dedup + idempotency + escalation state for a recurring regression. One row per
// (app, dedupKey); reused across daily runs so we comment-and-count instead of
// refiling, and escalate once occurrences pass the policy threshold.
model IssueLink {
  id              String   @id @default(cuid())
  app             App      @relation(fields: [appId], references: [id])
  appId           String
  dedupKey        String   // hash(journey + step + failure signature)
  externalIssueId String   // tracker issue id/identifier
  // open | fixed (tracker Done, awaiting outside re-verify — CHE-61)
  //      | resolved (fix verified by a walk) | suppressed (Canceled = not-a-bug, never auto-refile)
  status          String   @default("open")
  // Set when status becomes "suppressed": which of OUR failure modes produced a
  // claim the owner ruled not-a-bug (CHE-99). capability | configuration |
  // interpretation | bookkeeping; null = unclassified, needs a person to look.
  defectClass     String?
  // CHE-103: the finding this ticket was filed from. Recovering it by
  // re-hashing prose broke the moment we rewrote finding titles — a direct
  // pointer cannot. Nullable: links filed before this existed keep the hash
  // fallback, and capability/defect tickets have no Finding row at all.
  findingId       String?
  occurrences     Int      @default(1)
  escalatedAt     DateTime?
  firstSeenRunId  String?
  lastSeenAt      DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, dedupKey])
  @@index([appId])
}

// What the owner has settled about a signature, kept independently of the App
// row (CHE-101). IssueLink is per-app and dies with the app; this does not, so
// "we were told this is not a bug" survives an app being removed and re-added.
// Deliberately not a relation: the whole point is to outlive the thing it
// describes.
model SettledSignature {
  id              String   @id @default(cuid())
  ownerId         String?
  // CHE-253: "we were told this is not a bug" is the team's knowledge, not one
  // member's — a colleague must not re-file what the team already settled.
  // Plain id, not a relation, for the same reason ownerId is: this row is meant
  // to outlive what it describes.
  teamId          String?
  appSlug         String
  dedupKey        String
  externalIssueId String
  // suppressed = ruled not-a-bug | resolved = fix confirmed from outside |
  // superseded = the link was re-pointed at a newer ticket, and this preserves
  // the older ticket's identity instead of overwriting it into nothing.
  outcome         String
  defectClass     String?
  settledAt       DateTime @default(now())

  @@index([ownerId, appSlug])
  @@index([teamId, appSlug])
  @@index([externalIssueId])
}

// ─── LLM usage ledger ────────────────────────────────────────────────────────
// Tokens-model-money is the primary product metric: every unit of agent work
// (a phase, or one walked journey) records what model it ran on, the exact
// token counts, and the USD cost. Run.costUsd stays as the rolled-up total;
// these rows are the breakdown that survives model swaps (the cheap-model epic
// compares quality-per-dollar across providers on this data).

model LlmUsage {
  id    String @id @default(cuid())
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  // "discovery" | "walking" | "synthesis"; walking rows carry the journeyId.
  phase     String
  journeyId String?

  model            String
  inputTokens      Int    @default(0)
  cacheWriteTokens Int    @default(0)
  cacheReadTokens  Int    @default(0)
  outputTokens     Int    @default(0)
  iterations       Int    @default(0)
  costUsd          Float  @default(0)

  createdAt DateTime @default(now())

  @@index([runId])
}

// ─── App snapshots (CHE-132) ─────────────────────────────────────────────────
// What the app's pages looked like to a plain fetch — no browser, no model —
// taken at the start of every run. Two of them answer "did the app change since
// the last check?", and that answer, not the calendar, decides whether a run
// walks everything again (owner decision, 2026-09-03). The 7-day fuse in
// replay.ts applies only when two snapshots cannot be compared.

model AppSnapshot {
  id       String  @id @default(cuid())
  appSlug  String
  appId    String?
  // The run that took it. A plain id, not a relation — see Run.snapshotId.
  runId    String?
  takenAt  DateTime @default(now())

  // sha256 over the sorted per-page content hashes plus the bundle list: equal
  // fingerprints mean nothing served differently, whatever order it was seen in.
  fingerprint String
  // JSON. Rows before 2026-09-05: a bare SurveyPage[] — { url, path, status,
  // title, hash, forms, links }, hash = sha256 of the normalised HTML. Since
  // CHE-185: { digestVersion, volatile, pages: SurveyPage[] }, where hash is
  // the structural page digest and each page also carries rawHash (the old
  // hash, for diagnosis) and skeletonHash. Envelope, not a column, so old rows
  // parse without a migration (src/agent/snapshot.ts parseStoredPages).
  pages       String
  // JSON string[] — script URLs (same-origin and first-party CDN), deduped, sorted.
  bundles     String
  // Next.js build id when the app exposes one; the cleanest "a deploy happened".
  buildId     String?
  // JSON string[] — the stack signals lib/tech-signals read off the fetch.
  tech        String
  sitemapUrls Int     @default(0)
  // The homepage answered 403/429/503 or a bot challenge to a plain fetch:
  // nothing comparable was seen, so no comparison is made against this row.
  blocked     Boolean @default(false)
  // The page cap or the deadline stopped the survey with pages still
  // unvisited. An unvisited page is unknown, not removed — so this row is
  // compared only on the pages both sides saw, and only when they share
  // enough of them (CHE-179, src/agent/snapshot.ts isComparable). Otherwise a
  // slow app would read as "changed" every day and the calendar would be
  // back as a daily full run.
  truncated   Boolean @default(false)

  // Comparison with the snapshot before it. changed NULL = not comparable
  // (first snapshot, or a blocked side); diff is JSON
  // { addedPaths, removedPaths, changedPaths, bundlesChanged, buildIdChanged }.
  previousId String?
  changed    Boolean?
  diff       String?

  @@index([appSlug, takenAt])
  @@index([appId, takenAt])
}

// ─── The owner's Telegram channel (CHE-375) ──────────────────────────────────
// Every message in the owner's chat with @checkmyapp_bot, both directions: the
// webhook (src/app/api/webhooks/telegram/route.ts) stores what he writes,
// scripts/tg-send.ts stores what we send. Operator data, not a team's: no
// teamId, and no request-serving code reads it for a customer.

model TelegramMessage {
  id          String   @id @default(cuid())
  // Telegram's update_id, as text (its ids may outgrow Prisma's 32-bit Int).
  // Unique, because Telegram retries a delivery until it is acknowledged; NULL
  // for a message we sent, which arrives through no update.
  updateId    String?  @unique
  messageId   String?
  chatId      String
  // "in" = written to the bot · "out" = sent by us.
  direction   String
  fromName    String?
  // The text, or "<media>" (+ " " + caption) for a message without one.
  text        String
  // What this message replied to, cut to 200 chars.
  replyToText String?
  // An edit arrives as its own update and is stored as its own row.
  edited      Boolean  @default(false)
  // Outgoing only (src/lib/telegram-send.ts). sendId names one intended send
  // (by default a hash of chat + text), so a re-run cannot deliver it twice.
  // status: "pending" written, not yet attempted · "unknown" attempted, outcome
  // not confirmed · "sent" Telegram confirmed it · "failed" Telegram refused it.
  // NULL on incoming rows.
  sendId      String?  @unique
  status      String?
  // When Telegram says it was sent (or edited); createdAt is when we stored it.
  sentAt      DateTime
  createdAt   DateTime @default(now())

  @@index([chatId, createdAt])
}
